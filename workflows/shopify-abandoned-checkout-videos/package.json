{
  "name": "shopify-abandoned-checkout-videos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Create personalized checkout recovery videos with Zvid and optional reviewed SMTP delivery.",
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zvid-io/workflow-examples.git",
    "directory": "workflows/shopify-abandoned-checkout-videos"
  },
  "bugs": {
    "url": "https://zvid.io/contact"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/check.js",
    "test": "node --test tests/*.test.js",
    "offline": "node src/index.js --fixture data/checkout.json --offline --out out/sample",
    "dry-run": "node src/index.js --fixture data/checkout.json --dry-run --out out/preview",
    "sample": "node src/index.js --fixture data/checkout.json --out out/sample-render"
  },
  "dependencies": {
    "@zvid/sdk": "0.2.0",
    "nodemailer": "10.2.1"
  }
}
