{
  "name": "zvid-video-to-shorts-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prepare word-timed highlights from a direct video URL and render captioned vertical clips with Zvid.",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/check.js",
    "test": "node --test tests/*.test.js",
    "offline": "node src/index.js --sample --offline --out out/sample",
    "sample": "node src/index.js --sample --out out/sample",
    "prepare-video": "node src/index.js",
    "render-prepared": "node src/index.js --render-prepared",
    "resume": "node src/index.js --resume"
  },
  "dependencies": { "@zvid/sdk": "0.2.0" },
  "repository": { "type": "git", "url": "https://github.com/Zvid-io/workflow-examples.git", "directory": "workflows/video-to-shorts" },
  "bugs": { "url": "https://zvid.io/contact" },
  "license": "MIT"
}
