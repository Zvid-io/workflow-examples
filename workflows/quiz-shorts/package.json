{
  "name": "quiz-shorts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Create balanced quiz episodes and a source-backed answer pack with the official Zvid SDK.",
  "engines": {
    "node": ">=22.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zvid-io/workflow-examples.git",
    "directory": "workflows/quiz-shorts"
  },
  "bugs": {
    "url": "https://zvid.io/contact"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "check": "node src/check.js",
    "test": "node --test tests/*.test.js",
    "offline": "node src/index.js --offline",
    "sample": "node --env-file-if-exists=.env src/index.js --dry-run"
  },
  "dependencies": {
    "@zvid/sdk": "0.2.0"
  }
}
