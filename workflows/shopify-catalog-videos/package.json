{
  "name": "shopify-catalog-videos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn eligible Shopify catalog products into branded Zvid videos, with optional Shopify media publishing.",
  "engines": { "node": ">=20.12" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Zvid-io/workflow-examples.git", "directory": "workflows/shopify-catalog-videos" },
  "bugs": { "url": "https://zvid.io/contact" },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/check.js",
    "test": "node --test tests/*.test.js",
    "offline": "node src/index.js --fixture data/catalog.json --offline",
    "dry-run": "node src/index.js --dry-run",
    "sample": "node src/index.js --fixture data/catalog.json --out out/sample"
  },
  "dependencies": { "@zvid/sdk": "0.2.0" }
}
