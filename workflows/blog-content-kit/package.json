{
  "name": "zvid-blog-content-kit-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn an RSS article into two coordinated videos and a share image.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/check.js",
    "test": "node --test tests/*.test.js",
    "offline": "node src/index.js --sample --offline --out out/sample",
    "sample": "node src/index.js --sample --dry-run --out out/sample",
    "dry-run": "node src/index.js --dry-run",
    "render-prepared": "node src/index.js --render-prepared",
    "resume": "node src/index.js --resume"
  },
  "dependencies": {
    "@zvid/sdk": "0.2.0",
    "rss-parser": "3.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zvid-io/workflow-examples.git",
    "directory": "workflows/blog-content-kit"
  },
  "bugs": {
    "url": "https://zvid.io/contact"
  },
  "license": "MIT"
}
