{
  "name": "zvid-chat-video-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Draft a video through Zvid MCP, review a signed quote and explicitly render it with saved-job recovery.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
