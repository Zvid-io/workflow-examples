{
  "name": "shopify-product-ad-variants",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Create Shopify product video ad variants with Zvid using the maintained n8n planner.",
  "engines": { "node": ">=20.12" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Zvid-io/workflow-examples.git", "directory": "workflows/shopify-product-ad-variants" },
  "bugs": { "url": "https://zvid.io/contact" },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/check.js",
    "test": "node --test tests/*.test.js",
    "offline": "node src/index.js --fixture data/products.offline.json --mode plan --max-products 2 --variants-per-product 2 --max-total-ads 4 --out out/offline",
    "validate": "node src/index.js --mode validate",
    "sample": "node src/index.js --fixture data/sample.json --config sample-config.json --max-products 1 --variants-per-product 1 --max-total-ads 1 --out out/sample"
  },
  "dependencies": { "@zvid/sdk": "0.2.0" }
}
